{
  "name": "@mailfast/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/mailfast-server",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@mailfast/auth": "workspace:*",
    "@mailfast/db": "workspace:*",
    "@mailfast/env": "workspace:*",
    "@mailfast/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.2"
  }
}
